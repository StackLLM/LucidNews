  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 30,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "ai-creator"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 6.0,
        "topic_dedup": false
      },
      "ai-creator": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "reliability": {
    "domains": {},
    "exclude_labels": []
  },
  "archive": {
    "enabled": true,
    "path": "archive.sqlite3",
    "reuse_analysis": true,
    "retry_failed_analysis": true,
    "retry_window_hours": 48,
    "max_analysis_attempts": 3
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.example.com",
    "smtp_port": 465,
    "imap_server": "imap.example.com",
    "imap_port": 993,
    "email_address": "newsletter@example.com",
    "password_env": "EMAIL_PASSWORD",
    "sender_name": "LucidNews",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "webhook": {
    "enabled": false,
    "url_env": "LUCIDNEWS_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "request_body": {
      "title": "#{message_title}",
      "status": "#{result}",
      "important_items": "#{important_items}",
      "all_items": "#{all_items}",
      "language": "#{language}",
      "summary": "#{summary}"
    },
    "headers": ""
  }
