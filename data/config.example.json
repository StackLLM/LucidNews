          "fetch_limit": 15,
          "min_score": 100,
          "profile": "tech-news"
        },
        {
          "subreddit": "netsec",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50,
          "profile": "tech-news"
        },
        {
          "subreddit": "devops",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": [
        "karpathy",
        "ylecun"
      ],
      "keywords": [],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5,
      "profile": "tech-news"
    },
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript",
        "Rust",
        "Go"
      ],
      "keywords": [],
      "min_stars": 10,
      "max_items": 30,
      "category": "open-source",
      "profile": "tech-news"
    },
    "gdelt": {
      "enabled": false,
      "query": "(cybersecurity OR \"cloud computing\" OR \"open source\")",
      "mode": "ArtList",
      "max_records": 75,
      "timespan": null,
      "language": null,
      "country": null,
      "category": "news",
      "profile": "tech-news"
    },
    "google_news": {
      "enabled": false,
      "query": "\"artificial intelligence\" OR cybersecurity OR kubernetes",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 100,
      "category": "news",
      "profile": "tech-news"
    }
