# LucidNews environment variables.
# Copy to .env and fill in only what you use. Never commit .env.
# data/config.json references these by NAME (e.g. "api_key_env": "GOOGLE_API_KEY").

# --- AI provider (configure at least the one selected in data/config.json) ---
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DOUBAO_API_KEY=
MINIMAX_API_KEY=
# Optional override of the Ollama endpoint (default http://localhost:11434/v1)
LUCIDNEWS_OLLAMA_BASE_URL=

# --- Sources (optional) ---
# GitHub token raises the API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
# Apify token, required for Twitter/X in "apify" mode.
APIFY_TOKEN=
# LWN subscriber key, used by the optional full-text LWN feed.
LWN_KEY=

# --- Delivery (optional) ---
# SMTP/IMAP password for the newsletter mailbox (email.password_env).
EMAIL_PASSWORD=
# Webhook URL (webhook.url_env).
LUCIDNEWS_WEBHOOK_URL=

# --- Tooling (optional) ---
# Remote preset catalog for lucidnews-wizard; local data/presets.json is used when unset.
LUCIDNEWS_PRESETS_URL=
# MCP server: project path and secrets file.
LUCIDNEWS_PATH=
LUCIDNEWS_MCP_SECRETS_PATH=
